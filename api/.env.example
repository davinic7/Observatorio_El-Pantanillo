# Backend — Observatorio Industrial
# Copiar este archivo a `.env` y completar con valores reales.
# NUNCA versionar el .env real (ya está en .gitignore).

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=observatorio_industrial
DB_USER=postgres
# Render usa DB_PASSWORD por convención.
# DB_PASS también es soportado por retrocompatibilidad.
DB_PASSWORD=changeme

# --- JWT ---
# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar_por_un_secret_aleatorio_de_64_chars

# --- CORS ---
# URL del frontend permitido. Local: http://localhost:5173
# Producción: la URL pública de tu frontend (ej. https://obs-front.onrender.com)
FRONTEND_URL=http://localhost:5173
